#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# Source, config, docs, and CI files should stay lf across platforms
.gitattributes text eol=lf
*.gradle        text eol=lf
*.java          text eol=lf
*.json          text eol=lf
*.lockfile      text eol=lf
*.md            text eol=lf
*.properties    text eol=lf
*.py            text eol=lf
*.txt           text eol=lf
*.xml           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Large source/reference assets live in Git LFS. These docs-only patterns
# deliberately exclude shipped game textures under src/main/resources.
docs/superpowers/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
docs/superpowers/assets/**/*.obj filter=lfs diff=lfs merge=lfs -text
docs/superpowers/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
