{
	"schema_version": 1,
	"quilt_loader": {
		"group": "dev.attuned",
		"id": "attuned",
		"version": "${version}",
		"metadata": {
			"name": "Attuned",
			"description": "An attunement-economy accessory framework. Equip Foci into inventory slots and spend a limited attunement budget on their effects.",
			"contributors": {
				"defnotean": "Owner"
			},
			"contact": {
				"homepage": "https://github.com/defnotean/attuned",
				"sources": "https://github.com/defnotean/attuned",
				"issues": "https://github.com/defnotean/attuned/issues"
			},
			"license": "MIT",
			"icon": "assets/attuned/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"main": "dev.attuned.quilt.AttunedQuilt",
			"client": "dev.attuned.quilt.AttunedQuiltClient"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.30.0-beta.8"
			},
			{
				"id": "fabric-api",
				"versions": ">=0.116.5"
			},
			{
				"id": "minecraft",
				"versions": "~1.21.1"
			},
			{
				"id": "java",
				"versions": ">=21"
			}
		]
	},
	"mixin": [
		"attuned.mixins.json",
		{
			"config": "attuned.client.mixins.json",
			"environment": "client"
		}
	]
}
